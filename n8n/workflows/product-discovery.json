{
  "name":"Commerce — Product Discovery",
  "nodes":[
    {"name":"Schedule","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[0,0],"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":6}]}}},
    {"name":"Supplier Feed","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[220,0],"parameters":{"method":"GET","url":"={{$env.SUPPLIER_FEED_URL}}","options":{"timeout":30000}}},
    {"name":"Normalize","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,0],"parameters":{"jsCode":"return items.map(item => { const p=item.json; if(!p.signals) throw new Error('Supplier item is missing evidence-backed intelligence signals'); return {json:{product:{externalId:String(p.id ?? p.externalId),title:String(p.title),description:p.description,currency:String(p.currency),cost:Number(p.cost),stock:Number(p.stock),imageUrls:Array.isArray(p.imageUrls)?p.imageUrls:[],category:p.category,source:String(p.source ?? 'supplier-feed')},market:String(p.market ?? $env.DEFAULT_MARKET),channel:String(p.channel ?? $env.DEFAULT_CHANNEL ?? 'store'),claims:Array.isArray(p.claims)?p.claims:[],supplierPolicy:p.supplierPolicy,signals:p.signals}}; });"}}},
    {"name":"Commerce API","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[660,0],"parameters":{"method":"POST","url":"={{$env.COMMERCE_API_URL}}/internal/catalog/ingest","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-internal-service-key","value":"={{$env.INTERNAL_SERVICE_KEY}}"}]},"sendBody":true,"contentType":"json","jsonBody":"={{$json}}","options":{"timeout":30000}}},
    {"name":"Decision","type":"n8n-nodes-base.if","typeVersion":2,"position":[900,0],"parameters":{"conditions":{"options":{"caseSensitive":true},"conditions":[{"leftValue":"={{$json.result.score.decision}}","rightValue":"test","operator":{"type":"string","operation":"equals"}}]}}},
    {"name":"Publish Candidate","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[1140,0],"parameters":{"method":"POST","url":"={{$env.COMMERCE_API_URL}}/internal/catalog/candidates","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-internal-service-key","value":"={{$env.INTERNAL_SERVICE_KEY}}"}]},"sendBody":true,"contentType":"json","jsonBody":"={{ {productId:$json.result.productId,market:$json.result.market,channel:$json.result.channel,category:$json.result.category} }}","options":{"timeout":30000}}}
  ],
  "connections":{
    "Schedule":{"main":[[{"node":"Supplier Feed","type":"main","index":0}]]},
    "Supplier Feed":{"main":[[{"node":"Normalize","type":"main","index":0}]]},
    "Normalize":{"main":[[{"node":"Commerce API","type":"main","index":0}]]},
    "Commerce API":{"main":[[{"node":"Decision","type":"main","index":0}]]},
    "Decision":{"main":[[{"node":"Publish Candidate","type":"main","index":0}],[]]}
  }
}
